{
  "jobId": "temp-range",
  "source": "kafka://etl.input.v1",
  "transformations": [
    {
      "type": "filter_greater",
      "params": {
        "sensor": "temperature",
        "field": "measurement",
        "threshold": 15
      }
    },
    {
      "type": "filter_less",
      "params": {
        "sensor": "temperature",
        "field": "measurement",
        "threshold": 35
      }
    }
  ]
}
