{
  "jobId": "test-max-temp-job",
  "source": "kafka://etl.input.v1",
  "transformations": [
    {
      "type": "filter_greater",
      "params": {
        "sensor": "temperature",
        "field": "measurement",
        "threshold": 25
      }
    },
    {
      "type": "to_uppercase",
      "params": {
        "field": "location"
      }
    }, 
    {
      "type": "max",
      "keyBy": "location",
      "params": {
        "field": "measurement",
        "sensor": "temperature"
      }
    }
  ]
}