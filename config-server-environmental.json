{
  "jobId": "server-environmental-job",
  "source": "kafka://etl.input.v1",
  "transformations": [
    {
      "type": "filter_less",
      "params": {
        "field": "measurement",
        "threshold": 80.0
      }
    },
    {
      "type": "sum",
      "keyBy": "location",
      "window": "10s"
    }
  ],
  "outputTopic": "etl.output.v1"
}