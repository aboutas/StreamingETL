{
  "jobId": "comprehensive-dashboard-job",
  "source": "kafka://etl.input.v1",
  "transformations": [
    {
      "type": "filter_greater",
      "params": {
        "field": "measurement",
        "threshold": 0.0
      }
    },
    {
      "type": "sum",
      "keyBy": "measurement_unit",
      "window": "15s"
    }
  ],
  "outputTopic": "etl.output.v1"
}