{
  "jobId": "light-high-humidity",
  "source": "kafka://etl.input.v1",
  "transformations": [
    {
      "type": "filter_greater",
      "params": {
        "sensor": "light",
        "field": "measurement",
        "threshold": 500.0
      }
    },
    {
      "type": "max",
      "keyBy": "location",
      "params": {
        "field": "measurement",
        "sensor": "light"
      }
    }
  ]
}