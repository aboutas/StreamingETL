{
  "jobId": "noise-levels",
  "source": "kafka://etl.input.v1",
  "transformations": [
    {
      "type": "filter_greater",
      "params": {
        "sensor": "noise",
        "field": "measurement",
        "threshold": 60.0
      }
    },
    {
      "type": "max",
      "keyBy": "location",
      "params": {
        "field": "measurement",
        "sensor": "noise"
      }
    }
  ]
}
