{
  "jobId": "4t-temp-advanced",
  "source": "kafka://etl.input.v1",
  "transformations": [
    {
      "type": "filter_greater",
      "params": {
        "sensor": "temperature",
        "field": "measurement",
        "threshold": 30
      }
    },
    {
      "type": "to_uppercase",
      "params": {
        "field": "location"
      }
    },
    {
      "type": "trim_whitespace",
      "params": {
        "field": "measurement_unit"
      }
    },
    {
      "type": "to_lowercase",
      "params": {
        "field": "data_quality"
      }
    }
  ]
}
