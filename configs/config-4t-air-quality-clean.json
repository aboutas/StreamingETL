{
  "jobId": "4t-air-quality-clean",
  "source": "kafka://etl.input.v1",
  "transformations": [
    {
      "type": "filter_greater",
      "params": {
        "sensor": "air_quality",
        "field": "measurement",
        "threshold": 50
      }
    },
    {
      "type": "to_lowercase",
      "params": {
        "field": "location"
      }
    },
    {
      "type": "trim_whitespace",
      "params": {
        "field": "sensor"
      }
    },
    {
      "type": "to_uppercase",
      "params": {
        "field": "data_quality"
      }
    }
  ]
}
