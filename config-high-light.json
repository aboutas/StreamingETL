{
  "jobId": "high-light",
  "source": "kafka://etl.input.v1",
  "transformations": [
    {
      "type": "filter_greater",
      "params": {
        "sensor": "light",
        "field": "measurement",
        "threshold": 500
      }
    },
    {
      "type": "to_lowercase",
      "params": {
        "field": "measurement_unit"
      }
    }
  ]
}
