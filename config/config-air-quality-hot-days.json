{
  "jobId": "air-quality-hot-days",
  "source": "kafka://etl.input.v1",
  "transformations": [
    {
      "type": "filter_greater",
      "params": {
        "sensor": "air_quality",
        "field": "measurement",
        "threshold": 100.0
      }
    },
    {
      "type": "max",
      "keyBy": "location",
      "params": {
        "field": "measurement",
        "sensor": "air_quality"
      }
    }
  ]
}