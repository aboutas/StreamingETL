{
  "jobId": "temperature-monitoring-job",
  "source": "kafka://etl.input.v1",
  "transformations": [
    {
      "type": "filter_greater",
      "params": {
        "field": "measurement",
        "threshold": 25.0
      }
    },
    {
      "type": "max",
      "keyBy": "sensor",
      "window": "5s"
    }
  ],
  "outputTopic": "etl.output.v1"
}