{
  "jobId": "low-humidity",
  "source": "kafka://etl.input.v1",
  "transformations": [
    {
      "type": "filter_less",
      "params": {
        "sensor": "humidity",
        "field": "measurement",
        "threshold": 40
      }
    },
    {
      "type": "trim_whitespace",
      "params": {
        "field": "location"
      }
    }
  ]
}
