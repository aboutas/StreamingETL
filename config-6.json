{
  "jobId": "normalized-temp",
  "source": "kafka://etl.input.v1",
  "transformations": [
    {
      "type": "filter_greater",
      "params": {
        "sensor": "temperature",
        "field": "measurement",
        "threshold": 3
      }
    },
    {
      "type": "normalize",
      "params": {
        "field": "measurement",
        "min": 0,
        "max": 100
      }
    }
  ]
}
