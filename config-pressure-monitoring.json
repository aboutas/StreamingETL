{
  "jobId": "pressure-monitoring",
  "source": "kafka://etl.input.v1",
  "transformations": [
    {
      "type": "filter_greater",
      "params": {
        "sensor": "pressure",
        "field": "measurement",
        "threshold": 1020.0
      }
    },
    {
      "type": "max",
      "keyBy": "location",
      "params": {
        "field": "measurement",
        "sensor": "pressure"
      }
    }
  ]
}
