{
  "jobId": "cold-humid-rooms",
  "source": "kafka://etl.input.v1",
  "transformations": [
    {
      "type": "filter_less",
      "params": {
        "sensor": "temperature",
        "field": "measurement",
        "threshold": 20.0
      }
    },
    {
      "type": "filter_greater",
      "params": {
        "sensor": "humidity",
        "field": "measurement",
        "threshold": 70.0
      }
    },
    {
      "type": "max",
      "keyBy": "location",
      "params": {
        "field": "measurement",
        "sensor": "humidity"
      }
    }
  ]
}