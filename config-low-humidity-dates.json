{
  "jobId": "low-humidity-dates",
  "source": "kafka://etl.input.v1",
  "transformations": [
    {
      "type": "filter_less",
      "params": {
        "sensor": "humidity",
        "field": "measurement",
        "threshold": 30.0
      }
    },
    {
      "type": "max",
      "keyBy": "location",
      "params": {
        "field": "datetime",
        "sensor": "humidity"
      }
    }
  ]
}